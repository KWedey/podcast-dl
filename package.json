{
  "name": "podcast-dl",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tool that downloads podcast episodes from RSS feeds as MP3 files",
  "type": "module",
  "bin": {
    "podcast-dl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npx tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/write-file-atomic": "^4.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "feedsmith": "^2.9.0",
    "filenamify": "^7.0.1",
    "picocolors": "^1.1.1",
    "write-file-atomic": "^7.0.0"
  }
}
